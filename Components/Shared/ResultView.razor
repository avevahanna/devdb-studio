@using System.Text
@using System.Text.Json
@using DbServeApp.Services.Dbms
@inject IJSRuntime JS

<div class="result">
    @if (_blocks.Count > 0 && !Raw)
    {
        <div class="seg result__bar">
            <button type="button" class="seg__btn @(!_raw ? "seg__btn--on" : "")" @onclick="() => _raw = false">Table</button>
            <button type="button" class="seg__btn @(_raw ? "seg__btn--on" : "")" @onclick="() => _raw = true">Raw</button>
        </div>
    }
    @if (_raw || Raw)
    {
        <pre class="logs logs--nowrap">@Output</pre>
    }
    else
    {
        @foreach (var b in _blocks)
        {
            @if (b.Table is { } t)
            {
                <div class="result__export">
                    <button type="button" class="btn btn-sm" @onclick="() => ExportAsync(t, false)">Download CSV</button>
                    <button type="button" class="btn btn-sm" @onclick="() => ExportAsync(t, true)">Download JSON</button>
                </div>
                <div class="grid-wrap">
                    <table class="grid">
                        <thead><tr><th class="grid__n">#</th>@foreach (var c in t.Columns) { <th>@c</th> }</tr></thead>
                        <tbody>
                            @for (var r = 0; r < t.Rows.Count; r++)
                            {
                                <tr>
                                    <td class="grid__n">@(r + 1)</td>
                                    @foreach (var v in t.Rows[r]) { <td class="@(v == "NULL" ? "grid__null" : null)">@v</td> }
                                </tr>
                            }
                            @if (t.Rows.Count == 0) { <tr><td colspan="@(t.Columns.Count + 1)" class="muted">No rows.</td></tr> }
                        </tbody>
                    </table>
                </div>
                @if (t.Footer is not null) { <div class="grid__footer">@t.Footer</div> }
            }
            else
            {
                <pre class="logs logs--nowrap result__text">@b.Text</pre>
            }
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string Output { get; set; } = "";
    /// <summary>Show the output as plain text instead of parsing it into tables (document databases).</summary>

    private IReadOnlyList<ResultBlock> _blocks = [];
    private string? _parsedFor;
    private bool _raw;
    [Parameter] public bool Raw { get; set; }

    private async Task ExportAsync(ResultTable t, bool json)
    {
        var name = $"result-{DateTime.Now:yyyyMMdd-HHmmss}";
        var (content, ext, mime) = json
            ? (ToJson(t), "json", "application/json")
            : ("\uFEFF" + ToCsv(t), "csv", "text/csv");
        await JS.InvokeVoidAsync("dbServe.download", $"{name}.{ext}", content, $"{mime};charset=utf-8");
    }

    private static string ToCsv(ResultTable t)
    {
        static string Q(string v) => v.IndexOfAny(['"', ',', ';', '\r', '\n']) >= 0 ? "\"" + v.Replace("\"", "\"\"") + "\"" : v;
        var sb = new StringBuilder();
        sb.Append(string.Join(',', t.Columns.Select(Q))).Append("\r\n");
        foreach (var row in t.Rows)
            sb.Append(string.Join(',', row.Select(v => v == "NULL" ? "" : Q(v)))).Append("\r\n");
        return sb.ToString();
    }

    private static string ToJson(ResultTable t)
    {
        // Duplicate or empty column names get a numeric suffix so every value is kept.
        var names = new List<string>();
        for (var i = 0; i < t.Columns.Count; i++)
        {
            var n = t.Columns[i].Length == 0 ? $"column{i + 1}" : t.Columns[i];
            var unique = n;
            for (var k = 2; names.Contains(unique); k++) unique = $"{n}_{k}";
            names.Add(unique);
        }
        var rows = t.Rows.Select(r =>
        {
            var o = new Dictionary<string, string?>();
            for (var i = 0; i < names.Count; i++) o[names[i]] = i < r.Count && r[i] != "NULL" ? r[i] : null;
            return o;
        });
        return JsonSerializer.Serialize(rows, new JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
    }

    protected override void OnParametersSet()
    {
        if (_parsedFor == Output) return;
        _parsedFor = Output;
        _blocks = SqlcmdOutputParser.Parse(Output);
    }
}
