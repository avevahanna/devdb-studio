@using DevDbStudio.Services.Dbms

<span class="dbms dbms--@Key.ToLowerInvariant()" title="@Label">
    <span class="dbms__logo">
        @if (IconFile is not null) { <img src="icons/@IconFile" alt="" /> } else { @Abbrev }
    </span>
    <span class="dbms__text">
        <span class="dbms__name">@Label</span>
        @if (!string.IsNullOrEmpty(Tag)) { <span class="dbms__tag">@Tag</span> }
    </span>
</span>

@code {
    [Parameter, EditorRequired] public string Key { get; set; } = "";
    [Parameter] public string? DisplayName { get; set; }
    [Parameter] public string? Tag { get; set; }

    private string Label => DisplayName ?? Key switch
    {
        "mssql" => "Microsoft SQL Server",
        "postgres" => "PostgreSQL",
        "mariadb" => "MariaDB",
        "mysql" => "MySQL",
        "mongodb" => "MongoDB",
        "timescaledb" => "TimescaleDB",
        "redis" => "Redis",
        "couchdb" => "CouchDB",
        _ => Key,
    };

    private string? IconFile => Key.ToLowerInvariant() switch
    {
        "mssql" => "mssql.svg",
        "postgres" => "postgresql.svg",
        "mariadb" => "mariadb.svg",
        "mysql" => "mysql.svg",
        "mongodb" => "mongodb.svg",
        "timescaledb" => "timescale.svg",
        "redis" => "redis.svg",
        "couchdb" => "couchdb.svg",
        _ => null,
    };

    private string Abbrev => Key.ToLowerInvariant() switch
    {
        "mssql" => "SQL",
        "postgres" => "PG",
        "mariadb" => "MDB",
        "mysql" => "MY",
        _ => Key.Length > 3 ? Key[..3].ToUpperInvariant() : Key.ToUpperInvariant(),
    };
}
