@page "/instances/create"
@using DbServeApp.Services.Dbms
@implements IDisposable
@inject IInstanceManager Manager

<PageTitle>Create instance</PageTitle>

<div class="page-header">
    <div>
        <h1>Create instance</h1>
        <p>Start a new database server container in WSL.</p>
    </div>
    <a class="btn btn-sm" href="/instances">Back to instances</a>
</div>

@if (_result is { Success: true })
{
    <div class="banner">
        <div>
            <strong>@_result.Message</strong>
            <div>@_result.Instance?.Name is listening on port @_result.Instance?.HostPort.</div>
        </div>
        <a class="btn btn-success" href="/instances">Go to instances</a>
    </div>
}
else if (_result is not null)
{
    <div class="banner banner--error">
        <div>
            <strong>@_result.Message</strong>
            @if (!string.IsNullOrWhiteSpace(_result.StdErr)) { <pre class="logs">@_result.StdErr</pre> }
        </div>
    </div>
}

<div class="card">
    <div class="card__body form">
        <label class="field">DBMS
            <select @bind="_dbms" disabled="@_busy">
                @foreach (var p in Manager.Providers)
                {
                    <option value="@p.Key">@p.DisplayName</option>
                }
            </select>
        </label>
        <div class="inline-info"><DbmsBadge Key="@_dbms" DisplayName="@Manager.GetProvider(_dbms)?.DisplayName" Tag="@_tag" /></div>
        <label class="field">Name
            <input type="text" @bind="_name" @bind:event="oninput" maxlength="50" disabled="@_busy" />
        </label>
        <label class="field">Host port
            <input type="number" @bind="_port" min="1024" max="65535" disabled="@_busy" />
        </label>
        <label class="field">SA password
            <span class="inline">
                <input type="@(_showPw ? "text" : "password")" @bind="_password" @bind:event="oninput" autocomplete="new-password" disabled="@_busy" />
                <button type="button" class="btn btn-sm" @onclick="() => _showPw = !_showPw">@(_showPw ? "Hide" : "Show")</button>
            </span>
        </label>
        @if (_password.Length > 0)
        {
            var errs = InstanceValidation.PasswordErrors(_password);
            @if (errs.Count == 0) { <div class="hint hint--ok">Password meets the requirements.</div> }
            else { <ul class="hint hint--err">@foreach (var e in errs) { <li>@e</li> }</ul> }
        }
        <label class="field">Database name
            <input type="text" @bind="_database" disabled="@_busy" />
        </label>
        <label class="field">Image tag
            <input type="text" @bind="_tag" disabled="@_busy" />
        </label>
        <p class="muted">Image: <code>mcr.microsoft.com/mssql/server:@_tag</code>. The container is bound to 127.0.0.1 and uses a named volume for data.</p>

        @if (_errors.Count > 0)
        {
            <ul class="hint hint--err">@foreach (var e in _errors) { <li>@e</li> }</ul>
        }

        <div class="toolbar">
            <button class="btn btn-primary" @onclick="CreateAsync" disabled="@_busy">
                @if (_busy) { <span class="spinner"></span> }
                Create instance
            </button>
            @if (_busy) { <span class="muted">Creating… the first image pull can take several minutes.</span> }
        </div>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _cts = new();
    private string _dbms = "", _name = "", _password = "", _database = "master", _tag = "2022-latest";
    private int _port = 1433;
    private bool _busy, _showPw;
    private IReadOnlyList<string> _errors = [];
    private InstanceCreateResult? _result;

    protected override async Task OnInitializedAsync()
    {
        _dbms = Manager.Providers.FirstOrDefault()?.Key ?? "";
        var existing = await Manager.GetAllAsync(_cts.Token);
        var used = existing.Select(i => i.HostPort).ToHashSet();
        var p = 1433;
        while (used.Contains(p)) p++;
        _port = p;
        _name = $"sql-{existing.Count + 1}";
    }

    private async Task CreateAsync()
    {
        if (_busy) return;
        _result = null;
        var req = new InstanceCreateRequest(_name.Trim(), _dbms, _port, _password, _database.Trim(), _tag.Trim());
        _errors = InstanceValidation.Validate(req);
        if (_errors.Count > 0) return;

        _busy = true;
        try
        {
            _result = await Manager.CreateAsync(req, CancellationToken.None);
            if (_result.Success) _password = "";
        }
        catch (Exception ex) { _result = InstanceCreateResult.Fail("Unexpected error", ex.Message); }
        finally { _busy = false; }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
