@page "/query"
@using System.Text.Json
@using DbServeApp.Services.Dbms
@implements IDisposable
@inject IInstanceManager Manager
@inject ITableDataService Data
@inject IJSRuntime JS

<PageTitle>Query</PageTitle>

<div class="page-header">
    <div>
        <h1>Query</h1>
        <p>Run SQL (or mongosh commands for MongoDB) against a running instance using the DBMS command-line client inside the container.</p>
    </div>
</div>

@if (_instances is null)
{
    <div class="card"><div class="card__note" style="padding-top:14px">Loading instances…</div></div>
}
else if (_instances.Count == 0)
{
    <div class="card"><div class="card__note" style="padding-top:14px">No instances yet. <a href="/instances/create">Create one</a> first.</div></div>
}
else
{
    <div class="card">
        <div class="card__body form">
            <label class="field">Instance
                <select value="@_selected" @onchange="OnInstanceChanged" disabled="@_busy">
                    @foreach (var i in _instances)
                    {
                        <option value="@i.Id">@i.Name — @i.Status (port @i.HostPort)</option>
                    }
                </select>
            </label>
            @if (SelectedInstance is { } si)
            {
                <div class="inline-info">
                    <DbmsBadge Key="@si.DbmsKey" DisplayName="@Manager.GetProvider(si.DbmsKey)?.DisplayName" Tag="@si.ImageTag" />
                    <span class="muted">Default database: @si.DatabaseName · port @si.HostPort</span>
                </div>
            }
            <label class="field">Database
                <input type="text" list="query-databases" @bind="_database" disabled="@_busy" />
                <datalist id="query-databases">
                    @foreach (var d in _databases) { <option value="@d"></option> }
                </datalist>
            </label>
            <label class="field">@(SelectedProvider?.QueryLanguage ?? "SQL")
                <textarea rows="10" @bind="_sql" @bind:event="oninput" spellcheck="false" disabled="@_busy" data-run-target="#run-query"></textarea>
            </label>
            <div class="toolbar">
                <button id="run-query" class="btn btn-primary" @onclick="RunAsync" disabled="@(_busy || !CanRun)">
                    @if (_busy) { <span class="spinner"></span> }
                    Run
                </button>
                <button class="btn btn-sm" @onclick="RefreshAsync" disabled="@(_busy || _refreshing)">Re-run status</button>
                <span class="muted">Ctrl+Enter runs the query.</span>
                @if (!CanRun && SelectedInstance is not null)
                {
                    <span class="muted">The instance must be running to execute queries.</span>
                }
            </div>
        </div>
    </div>

    @if (_result is not null)
    {
        <div class="card card--@(_result.IsSuccess ? "pass" : "fail")">
            <div class="card__head">
                <span class="card__title">Result</span>
                <span class="chip @(_result.IsSuccess ? "chip--pass" : "chip--fail")">@(_result.IsSuccess ? "Success" : "Failed")</span>
                <span class="muted">@_result.Elapsed.TotalSeconds.ToString("0.00")s · exit code @_result.ExitCode</span>
            </div>
            <div class="card__body">
                @if (!string.IsNullOrWhiteSpace(_result.StdOut))
                {
                    <h4>Output</h4>
                    <ResultView Output="@_result.StdOut" Raw="@(SelectedProvider?.SupportsTables == false)" />
                }
                @if (!string.IsNullOrWhiteSpace(_result.StdErr))
                {
                    <h4>Errors</h4>
                    <pre class="logs">@_result.StdErr</pre>
                }
                @if (string.IsNullOrWhiteSpace(_result.StdOut) && string.IsNullOrWhiteSpace(_result.StdErr))
                {
                    <p class="muted">No output.</p>
                }
            </div>
        </div>
    }

    <div class="grid-2">
        <div class="card">
            <div class="card__head">
                <span class="card__title">History</span>
                @if (_history.Count > 0) { <button class="btn btn-sm" @onclick="ClearHistoryAsync">Clear</button> }
            </div>
            <div class="card__body">
                @if (_history.Count == 0)
                {
                    <p class="muted">Queries you run on this instance appear here.</p>
                }
                else
                {
                    <ul class="saved">
                        @foreach (var h in _history)
                        {
                            <li>
                                <button class="saved__main" title="@h.Sql" @onclick="() => _sql = h.Sql">
                                    <span class="saved__sql">@Preview(h.Sql)</span>
                                    <span class="muted">@h.Utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
        <div class="card">
            <div class="card__head"><span class="card__title">Saved snippets</span></div>
            <div class="card__body form">
                <div class="toolbar">
                    <label class="field">Name
                        <input type="text" maxlength="60" @bind="_snippetName" @bind:event="oninput" placeholder="e.g. Row counts" />
                    </label>
                    <button class="btn btn-sm" @onclick="SaveSnippetAsync" disabled="@(string.IsNullOrWhiteSpace(_snippetName) || string.IsNullOrWhiteSpace(_sql))">Save current SQL</button>
                </div>
                @if (_snippets.Count > 0)
                {
                    <ul class="saved">
                        @foreach (var s in _snippets)
                        {
                            <li>
                                <button class="saved__main" title="@s.Sql" @onclick="() => _sql = s.Sql">
                                    <strong>@s.Name</strong>
                                    <span class="saved__sql muted">@Preview(s.Sql)</span>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSnippetAsync(s)">Delete</button>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "instance")] public Guid? InstanceId { get; set; }

    private IReadOnlyList<DbInstance>? _instances;
    private readonly CancellationTokenSource _cts = new();
    private Guid _selected;
    private const string MssqlSample = "SELECT @@VERSION AS version;";
    private const string PostgresSample = "SELECT version();";
    private const string MariaDbSample = "SELECT VERSION() AS version;";
    private const string MongoSample =
        "// Server version\ndb.runCommand({ buildInfo: 1 }).version\n\n" +
        "// Add a document (the collection is created automatically)\n" +
        "// db.customers.insertOne({ name: \"Anna\", age: 30 })\n\n" +
        "// Find all customers\n" +
        "// db.customers.find().toArray()";
    private string _sql = MssqlSample;
    private string _database = "";
    private bool _busy, _refreshing, _rendered;
    private QueryResult? _result;
    private IReadOnlyList<string> _databases = [];
    private List<HistoryItem> _history = [];
    private List<Snippet> _snippets = [];
    private string _snippetName = "";

    private const int MaxHistory = 20;
    private const string SnippetsKey = "dbserve-snippets";
    private sealed record HistoryItem(string Sql, DateTime Utc);
    private sealed record Snippet(string Name, string Sql);
    private string HistoryKey => $"dbserve-history-{_selected}";

    private DbInstance? SelectedInstance => _instances?.FirstOrDefault(i => i.Id == _selected);
    private IDbmsProvider? SelectedProvider => SelectedInstance is null ? null : Manager.GetProvider(SelectedInstance.DbmsKey);
    private bool CanRun => SelectedInstance?.Status == InstanceStatus.Running && !string.IsNullOrWhiteSpace(_sql);

    private static string Preview(string sql)
    {
        var s = string.Join(' ', sql.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return s.Length > 90 ? s[..90] + "…" : s;
    }

    private async Task<List<T>> ReadStoredAsync<T>(string key)
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("dbServe.storageGet", key);
            return string.IsNullOrEmpty(json) ? [] : JsonSerializer.Deserialize<List<T>>(json) ?? [];
        }
        catch (Exception ex) when (ex is JsonException or JSException or InvalidOperationException) { return []; }
    }

    private async Task WriteStoredAsync<T>(string key, List<T> items)
    {
        try { await JS.InvokeVoidAsync("dbServe.storageSet", key, JsonSerializer.Serialize(items)); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _rendered = true;
        _snippets = await ReadStoredAsync<Snippet>(SnippetsKey);
        _history = await ReadStoredAsync<HistoryItem>(HistoryKey);
        await LoadDatabasesAsync();
        StateHasChanged();
    }

    private async Task LoadDatabasesAsync()
    {
        _databases = [];
        if (SelectedInstance is not { Status: InstanceStatus.Running }) return;
        try { _databases = await Data.ListDatabasesAsync(_selected, _cts.Token); }
        catch (OperationCanceledException) { }
    }

    private async Task AddHistoryAsync(string sql)
    {
        if (!_rendered || string.IsNullOrWhiteSpace(sql)) return;
        _history.RemoveAll(h => h.Sql == sql);
        _history.Insert(0, new HistoryItem(sql, DateTime.UtcNow));
        if (_history.Count > MaxHistory) _history.RemoveRange(MaxHistory, _history.Count - MaxHistory);
        await WriteStoredAsync(HistoryKey, _history);
    }

    private async Task ClearHistoryAsync()
    {
        _history = [];
        await WriteStoredAsync(HistoryKey, _history);
    }

    private async Task SaveSnippetAsync()
    {
        var name = _snippetName.Trim();
        if (name.Length == 0 || string.IsNullOrWhiteSpace(_sql)) return;
        _snippets.RemoveAll(s => string.Equals(s.Name, name, StringComparison.OrdinalIgnoreCase));
        _snippets.Insert(0, new Snippet(name, _sql));
        _snippetName = "";
        await WriteStoredAsync(SnippetsKey, _snippets);
    }

    private async Task DeleteSnippetAsync(Snippet s)
    {
        _snippets.Remove(s);
        await WriteStoredAsync(SnippetsKey, _snippets);
    }

    protected override async Task OnInitializedAsync()
    {
        _instances = await Manager.GetAllAsync(_cts.Token);
        _selected = _instances.FirstOrDefault(i => i.Id == InstanceId)?.Id
            ?? _instances.FirstOrDefault(i => i.Status == InstanceStatus.Running)?.Id
            ?? _instances.FirstOrDefault()?.Id ?? Guid.Empty;
        _database = SelectedInstance?.DatabaseName ?? "";
        UseSampleForInstance();
        await RefreshAsync();
    }

    // Swap the untouched sample query when switching between DBMSs.
    private void UseSampleForInstance()
    {
        if (_sql is MssqlSample or PostgresSample or MariaDbSample or MongoSample)
            _sql = SelectedInstance?.DbmsKey switch
            {
                PostgresProvider.ProviderKey => PostgresSample,
                MariaDbProvider.ProviderKey or MySqlProvider.ProviderKey => MariaDbSample,
                MongoDbProvider.ProviderKey => MongoSample,
                _ => MssqlSample,
            };
    }

    private async Task OnInstanceChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id)) return;
        _selected = id;
        _database = SelectedInstance?.DatabaseName ?? "";
        UseSampleForInstance();
        _result = null;
        if (!_rendered) return;
        _history = await ReadStoredAsync<HistoryItem>(HistoryKey);
        await LoadDatabasesAsync();
    }

    private async Task RefreshAsync()
    {
        if (_refreshing) return;
        _refreshing = true;
        try
        {
            _instances = (await Manager.RefreshStatusAsync(_cts.Token)).Instances;
            if (_rendered && _databases.Count == 0) await LoadDatabasesAsync();
        }
        catch (OperationCanceledException) { }
        finally { _refreshing = false; }
    }

    private async Task RunAsync()
    {
        if (_busy || !CanRun) return;
        _busy = true;
        _result = null;
        var db = _database.Trim();
        var key = SelectedInstance?.DbmsKey;
        var sql = db.Length == 0 || db == SelectedInstance?.DatabaseName
            ? _sql
            : key == MongoDbProvider.ProviderKey
                ? $"db = db.getSiblingDB(\"{db.Replace("\\", "").Replace("\"", "")}\");\n{_sql}"
                : TableDialect.For(key).Use(db) + _sql;
        try { _result = await Manager.ExecuteSqlAsync(_selected, sql, _cts.Token); }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) { _result = new QueryResult(false, "", ex.Message, -1, TimeSpan.Zero); }
        finally { _busy = false; }
        await AddHistoryAsync(_sql);
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
